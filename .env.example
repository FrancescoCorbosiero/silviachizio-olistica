# Copia in .env (NON va nel repo) e compila.

# ── Dominio (label di Caddy e URL assoluti: sitemap, canonical, Open Graph) ──
# Il dominio di Lily non è ancora deciso (docs/domande-aperte.md ★): finché
# manca, docker compose si ferma. In sviluppo locale non serve: senza
# NEXT_PUBLIC_SITE_URL il sito usa http://localhost:3000.
SITE_DOMAIN=
# Dominio alternativo (es. www.<dominio>) con redirect permanente al principale.
SITE_DOMAIN_ALT=
# https:// + SITE_DOMAIN. Entra al build: cambiarlo richiede --build.
NEXT_PUBLIC_SITE_URL=

# ── AWS SES: email delle richieste (/api/richiesta) ──────────────────
# Regione europea in cui è verificato il dominio in SES (es. eu-west-1,
# eu-south-1): l'informativa privacy dice che i dati restano in UE.
AWS_REGION=eu-west-1
# Utente IAM con il SOLO permesso ses:SendEmail.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Mittente su un dominio/indirizzo verificato in SES,
# es. "Lily Trattamenti Benessere <sito@<dominio>>".
SES_FROM=
# Dove arrivano le richieste (più indirizzi separati da virgola): l'email di
# Silvia è ancora una domanda aperta (★). Senza, la richiesta non parte e il
# sito offre il messaggio su Instagram. Con SES ancora in sandbox anche i
# destinatari vanno verificati.
#   SES_TO_TRATTAMENTI  "Prenota un trattamento" e gli avvisi di riapertura dei trattamenti
#   SES_TO_LETTURE      "Richiedi una lettura" e gli avvisi di riapertura delle letture
SES_TO_TRATTAMENTI=
SES_TO_LETTURE=
# Facoltativo: configuration set SES per metriche e rimbalzi.
SES_CONFIGURATION_SET=
# true = non invia, stampa le email nei log (prove/staging).
SES_DRY_RUN=false

# ── Dati legali ──────────────────────────────────────────────────────
# Partita IVA di Silvia, se c'è: compare nel piè di pagina, nell'informativa
# privacy e nelle email. Entra al build: dopo averla scritta,
# docker compose up -d --build.
NEXT_PUBLIC_PARTITA_IVA=

# ── Facoltativo ──────────────────────────────────────────────────────
# Codice di verifica di Google Search Console.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
